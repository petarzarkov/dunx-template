{
  "name": "dunx-template",
  "version": "0.1.0",
  "private": true,
  "description": "A production-shaped starter for dunx on Bun: Better Auth, Drizzle, BullMQ with a worker process, websockets, object storage, OpenAPI, an ops dashboard, Docker and CI.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/install-hooks.ts",
    "check": "bun run lint:check && bun run format:check && bun run typecheck && bun test",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "start:dist": "bun dist/main.js",
    "build": "bun ./scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --fix src scripts e2e",
    "lint:check": "oxlint --type-aware --max-warnings 0 src scripts e2e",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "test:unit": "bun test .test.ts",
    "test:int": "bun test .spec.ts",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test --preload ./e2e/setup/preload.ts $(find ./e2e -name '*.e2e.ts')",
    "mig:gen": "bun --env-file=.env drizzle-kit generate",
    "mig:run": "bun --env-file=.env ./scripts/migrate.ts",
    "db:studio": "bun --env-file=.env drizzle-kit studio",
    "db:drop": "bun ./scripts/db-drop.ts",
    "seed": "bun --env-file=.env ./scripts/seed.ts",
    "create:admin": "bun --env-file=.env ./scripts/create-admin.ts",
    "gen:openapi": "bunx dunx-openapi ./src/openapi.config.ts",
    "gen:env:docs": "bun ./scripts/gen-env-docs.ts",
    "mail:preview": "bunx dunx-email preview ./src/notifications/email/templates --renderer ./src/notifications/email/render.ts",
    "mail:export": "bunx dunx-email export ./src/notifications/email/templates --renderer ./src/notifications/email/render.ts --out ./.tmp/email"
  },
  "dependencies": {
    "@bull-board/api": "8.6.0",
    "@bull-board/bun": "8.6.0",
    "@bull-board/ui": "8.6.0",
    "@dunx/auth": "3.9.1",
    "@dunx/core": "3.9.1",
    "@dunx/dashboard": "3.9.1",
    "@dunx/http": "3.9.1",
    "@dunx/infra": "3.9.1",
    "@dunx/openapi": "3.9.1",
    "@dunx/transform": "3.9.1",
    "@react-email/components": "1.0.12",
    "@scalar/api-reference": "1.68.0",
    "better-auth": "1.6.25",
    "bullmq": "6.3.4",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.1",
    "rabbitmq-client": "5.0.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.1.2",
    "swagger-ui-dist": "5.32.14",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dunx/testing": "3.9.1",
    "@stagelint/stagelint": "0.1.4",
    "@types/bun": "1.4.1",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.17",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
