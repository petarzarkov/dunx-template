# Bun loads .env and .env.local itself, so there is no loader and no dotenv.
# Everything here is validated once at boot by src/config/env.validation.ts.

# ---- Service -----------------------------------------------------------------
# Required: there is no default, so boot fails without it.
API_PORT=3001
API_PREFIX=api
APP_ENV=local
NODE_ENV=development
TZ=UTC

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=debug
LOG_MASK_FIELDS=accessToken,jwt,password,secret,key,phone
LOG_FILTER_EVENTS=/api/service/up,/api/service/health,/favicon.ico
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ---- Health ------------------------------------------------------------------
HEALTH_MAX_MEMORY_MB=2048

# ---- HTTP --------------------------------------------------------------------
CORS_ORIGIN=*
TRUST_PROXY=false
DOCS_PATH=docs
DOCS_JSON_PATH=openapi.json

# ---- Database ----------------------------------------------------------------
# sqlite is the only supported value: the data layer is synchronous (bun:sqlite).
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/app.db
# POSTGRES_URL=postgres://user:pass@localhost:5432/app

# ---- Authentication (Better Auth) ---------------------------------------------
# Absent falls back to a constant in src/config/dto/auth-vars.dto.ts, which is fine
# locally and refused outright when APP_ENV=prod. 32 characters minimum.
# BETTER_AUTH_SECRET=
# Where cookies are issued for. Defaults to http://localhost:$API_PORT.
# WEB_URL=http://localhost:3001
# AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_SESSION_EXPIRATION=86400
AUTH_SESSION_UPDATE_AGE=3600
# `redis` puts live sessions in better-auth's secondaryStorage. It is an explicit
# opt-in because it does not degrade: choosing it is choosing to have Redis up.
AUTH_SESSION_STORE=database
# The first administrator, created through better-auth's own sign-up at boot.
# Never created when APP_ENV=prod.
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=admin-password
# A provider is enabled only when both halves are present.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ---- Redis, cache, throttling, queues and the websocket relay ------------------
# Absent is fine everywhere: the cache reports itself degraded, the throttler stops
# counting, the queue answers 503 and websocket fan-out stays local to the process.
# REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=500
CACHE_TTL_SECONDS=30
THROTTLE_PREFIX=dunx-template
THROTTLE_LIMIT=20
THROTTLE_WINDOW_SECONDS=60
QUEUE_PREFIX=dunx-template
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000
QUEUE_CONCURRENCY=3
QUEUE_RATE_LIMIT_MAX=100
QUEUE_RATE_LIMIT_DURATION=1000
QUEUE_JOB_TIMEOUT_MS=120000
WS_RELAY_CHANNEL=dunx-template:ws

# ---- Object storage ------------------------------------------------------------
# local is Bun.file and Bun.write under a directory; s3 is Bun.S3Client. Anything
# omitted below falls through to Bun's own credential resolution.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data/uploads
STORAGE_PREFIX=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,text/csv,application/pdf

# ---- Images (Bun.Image) --------------------------------------------------------
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=2048
IMAGE_THUMBNAIL_WIDTH=256

# ---- Build metadata (set by CI) ----------------------------------------------
# SERVICE_COMMIT_SHA=
# SERVICE_COMMIT_MESSAGE=
